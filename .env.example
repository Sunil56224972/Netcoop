# NetCoop AI Environment Configuration
# Target Infrastructure: IIT Bhubaneswar Campus Facilities

# Server Port & Host (Default: http://localhost:4000)
NETCOOP_PORT=4000
HOST=0.0.0.0

# Groq LLM Inference API Key (Sign up at https://console.groq.com)
# Model: openai/gpt-oss-120b (Ultra-fast LPU inference)
NETCOOP_GROQ_KEY=gsk_your_groq_api_key_here
NETCOOP_GROQ_MODEL=openai/gpt-oss-120b
