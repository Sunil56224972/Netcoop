# NetCoop AI Environment Configuration
# Note: NetCoop MCP Server (mcp.js) runs 100% locally in zero-credential,
# offline deterministic mode and requires ZERO environment variables or API keys.

# Standalone Web Server Port & Host (Default: http://localhost:4000)
NETCOOP_PORT=4000
HOST=0.0.0.0

# Optional Groq LPU Inference Key (Web Server only — never exported or used in MCP mode)
NETCOOP_GROQ_KEY=
NETCOOP_GROQ_MODEL=openai/gpt-oss-120b
